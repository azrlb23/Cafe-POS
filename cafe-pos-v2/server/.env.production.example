PORT=5000
NODE_ENV=production

# PostgreSQL production connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Contoh Neon.tech: postgresql://user:pass@ep-xxx.neon.tech/cafe_pos?sslmode=require
# Contoh Railway:   postgresql://postgres:pass@containers-us-west-xxx.railway.app:6543/railway
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cafe_pos?schema=public"

# Session secret — WAJIB diganti dengan string acak kuat (minimum 32 karakter)
# Generate dengan: openssl rand -hex 32
SESSION_SECRET="GANTI_DENGAN_RANDOM_STRING_PANJANG_MINIMAL_64_KARAKTER"

# URL domain frontend produksi (tanpa trailing slash)
FRONTEND_URL="https://cafe.denjavas.com"

# Supabase Storage Integration (Opsional, jika deploy ke Vercel/Serverless)
# Dapatkan dari: Project Settings -> API di dashboard Supabase
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx"
